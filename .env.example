# ============================================================================
# Antifrágil CFO — variables de entorno (PLANTILLA)
# ----------------------------------------------------------------------------
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se sube a GitHub (está en .gitignore).
# ============================================================================

# --- Supabase (públicas: llegan al navegador) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Supabase (privada: SOLO servidor, salta RLS) ---------------------------
# Nunca prefijar con NEXT_PUBLIC_. Nunca usar desde un Client Component.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Identificación de cuentas bancarias ------------------------------------
# Últimos 4 dígitos del IBAN de cada cuenta. Sirven para reconocer de qué cuenta
# es un extracto por su contenido. No se guardan datos bancarios en el repositorio.
# ANTIFRAGIL_IBAN_SL_TAIL=0000
# ANTIFRAGIL_IBAN_SC_TAIL=0000

# --- Zona local de datos financieros ----------------------------------------
# Carpeta donde viven extractos, facturas y salidas. Por defecto ./local-data
# ANTIFRAGIL_CFO_DATA_DIR=C:\ruta\a\tus\datos

# --- Google Drive (fase posterior) ------------------------------------------
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_FINANCE_FOLDER_ID=
